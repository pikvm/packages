From fcb89c1148b40c0e9607c1bdb5983b5fbadb057a Mon Sep 17 00:00:00 2001
From: Maxim Devaev <mdevaev@gmail.com>
Date: Sat, 4 Jul 2026 05:05:32 +0300
Subject: [PATCH 1303/1304] pikvm: gadget: uvc: Fixed kernel crash on closing
 /dev/videoN

If uvc_v4l2_streamoff() (via ioctl VIDIOC_STREAMOFF) was not called
before closing the device file with uvc_v4l2_release(), the kernel crashes.

Since uvc_v4l2_streamoff() contains uvcg_video_disable(),
we just have to call it before uvc_function_disconnect().
---
 drivers/usb/gadget/function/uvc_v4l2.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/usb/gadget/function/uvc_v4l2.c b/drivers/usb/gadget/function/uvc_v4l2.c
index 624215508ed6..f6e4d9fef166 100644
--- a/drivers/usb/gadget/function/uvc_v4l2.c
+++ b/drivers/usb/gadget/function/uvc_v4l2.c
@@ -534,8 +534,8 @@ uvc_v4l2_subscribe_event(struct v4l2_fh *fh,
 
 static void uvc_v4l2_disable(struct uvc_device *uvc)
 {
-	uvc_function_disconnect(uvc);
 	uvcg_video_disable(&uvc->video);
+	uvc_function_disconnect(uvc);
 	uvcg_free_buffers(&uvc->video.queue);
 	scoped_guard(mutex, &uvc->lock)
 		uvc->func_connected = false;
-- 
2.55.0

