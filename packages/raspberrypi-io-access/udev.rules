# https://github.com/raspberrypi/linux/issues/1225

ACTION=="remove", GOTO="end"

SUBSYSTEM=="i2c-dev", GROUP="i2c", MODE="0660"
SUBSYSTEM=="spidev", GROUP="spi", MODE="0660"
SUBSYSTEM=="gpiomem", KERNEL=="gpiomem", GROUP="gpio", MODE="0660"

# this rule acts on /dev/gpiochipN
SUBSYSTEM=="gpio", ENV{DEVTYPE}=="gpio_chip", KERNEL=="gpiochip*", GROUP="gpio", MODE="0660"

# this rule acts on /sys/class/gpio/gpiochipN, which are part of the legacy sysfs gpio ABI and _not_ the same nodes as the above
# (N signifies the base gpio line number)
# NB: this is extremely ugly, but we use this rule to adjust global /sys/class/gpio/{export,unexport} because it does not trigger too often
SUBSYSTEM=="gpio", ENV{DEVTYPE}!="?*", ENV{DEVNAME}!="?*", KERNEL=="gpiochip[0-9]*", RUN+="/bin/bash -ec 'f() { chgrp gpio $$@; chmod g=u $$@; }; f %S/class/gpio/{export,unexport}'"

# this rule acts on /sys/class/gpio/gpioN, which are individual GPIO lines exported for use with the legacy sysfs gpio ABI
SUBSYSTEM=="gpio", ENV{DEVTYPE}!="?*", ENV{DEVNAME}!="?*", KERNEL=="gpio[0-9]*", RUN+="/bin/bash -ec 'f() { chgrp gpio $$@; chmod g=u $$@; }; f %S%p/{active_low,direction,value}'"

# pwm subsystem is braindead and does not emit events for contained pwmN devices
# as such, this rule acts on pwmchipN nodes but adjusts both pwmchipN nodes themselves and contained pwmchipN/pwmM nodes
SUBSYSTEM=="pwm", ENV{DEVTYPE}!="?*", ENV{DEVNAME}!="?*", KERNEL=="pwmchip[0-9]*", RUN+="/bin/bash -ex -O nullglob -c 'f() { chgrp pwm $$@; chmod g=u $$@; }; f %S%p/{export,unexport} %S%p/pwm*/{capture,duty_cycle,enable,period,polarity}'"

LABEL="end"
