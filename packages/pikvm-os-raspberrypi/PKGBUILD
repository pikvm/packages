pkgname=pikvm-os-raspberrypi
pkgver=0.10
pkgrel=1
pkgdesc="PiKVM OS Metapackage"
url="https://pikvm.org"
license=(GPL)
arch=(any)
depends=(
	linux-api-headers-pikvm
	linux-firmware-pikvm
	firmware-raspberrypi-pikvm
	raspberrypi-bootloader-pikvm
	linux-rpi-pikvm
	linux-rpi-headers-pikvm
	raspberrypi-utils
	pikvm-os-updater
	pikvm-os-ro
	pistat
	busybox
)
replaces=(pikvm-os-raspberrypi4)
source=(rpi-brcmfmac.conf disabled-unsafe.conf)
md5sums=(SKIP SKIP)


package() {
	cd "$srcdir"
	install -Dm644 -t "$pkgdir/usr/lib/modprobe.d" rpi-brcmfmac.conf
	install -Dm644 -t "$pkgdir/usr/lib/modprobe.d" disabled-unsafe.conf
}
