pkgname=python-luma-core
pkgver=2.6.0
pkgrel=3
pkgdesc="A component library to support SBC display drivers"
url="https://github.com/rm-hull/luma.core"
license=(MIT)
arch=(any)
depends=(
	"python>=3.14"
	"python<3.15"
	python-deprecated
	python-pillow
	"python-cbor2>=5.4.3-2"
	python-spidev
	python-smbus2
	python-pyftdi
	"libgpiod>=2.1"
)
conflicts=(
	python-cbor2-pikvm
)
makedepends=(python-distribute)
source=("https://github.com/rm-hull/luma.core/archive/${pkgver}.tar.gz" "314.patch")
sha1sums=(SKIP SKIP)


package() {
	cd "$srcdir/luma.core-$pkgver"
	patch -p1 < ../314.patch
	python setup.py install --prefix=/usr --root="$pkgdir" --optimize=1
}
